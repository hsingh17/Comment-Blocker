{
  "manifest_version": 3,
  "name": "Comment Blocker",
  "version": "1.0",
  "description": "",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "unlimitedStorage",
    "scripting",
    "webNavigation",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  }
}
